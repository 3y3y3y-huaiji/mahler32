#!/bin/sh
# Refuse credentials, submission scratch files and stray root-level .json.
# Installed with: git config core.hooksPath .githooks
# Bypass is deliberately awkward: git commit --no-verify (see AGENTS.md, rule 4).
if command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    PY=python
fi
exec "$PY" scripts/check_no_secrets.py --staged
